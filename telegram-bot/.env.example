# Token du bot (@BotFather)
BOT_TOKEN=123456:ABC-DEF...

# ID du canal privé (ex: -1001234567890). Le bot doit être admin.
CHANNEL_ID=-1001234567890

# Secret partagé pour sécuriser le webhook (chaîne aléatoire)
WEBHOOK_SECRET=change-me-long-random-string

# IDs Telegram des admins (séparés par des virgules) — pour /stats, /reindex helpers
ADMIN_IDS=123456789

# Upstash Redis (obligatoire sur Vercel pour persister le catalogue)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx

# URL publique Vercel (sans slash final) — utilisée par /api/setup
PUBLIC_URL=https://ton-projet.vercel.app
